# FlipFinder (public excerpt) — configuration surface.
# No secrets are required: the models run locally via Ollama and there are no
# paid API keys in this excerpt. Copy to .env and override only what you need.

# Local Ollama model for the keep/drop product classifier.
FF_TEXT_MODEL=

# Local Ollama vision model for the price backstop.
FF_VISION_MODEL=

# Ollama server address, if not the default localhost:11434.
OLLAMA_HOST=

# SQLite path for the leads database. Defaults to db/flipfinder.db.
FF_DB_PATH=
